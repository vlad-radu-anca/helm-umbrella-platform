{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "description": "Global values passed from the umbrella chart",
      "additionalProperties": true
    },
    "kibana": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string" },
        "elasticsearchFullname": { "type": "string" },
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string" },
        "replicaCount": { "type": "integer" },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nameOverride": { "type": "string" },
        "fullnameOverride": { "type": "string" },
        "podAnnotations": {
          "type": ["object", "null"],
          "additionalProperties": { "type": "string" }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer" }
          },
          "required": ["type", "port"]
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": {
              "type": ["object", "null"],
              "additionalProperties": { "type": "string" }
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "host": { "type": "string" },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": { "type": "string" },
                        "pathType": { "type": "string" }
                      },
                      "required": ["path", "pathType"]
                    }
                  }
                },
                "required": ["host", "paths"]
              }
            },
            "tls": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "secretName": { "type": "string" },
                  "hosts": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "required": ["secretName", "hosts"]
              }
            }
          },
          "required": ["enabled", "hosts"]
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" }
              },
              "required": ["cpu", "memory"]
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" }
              },
              "required": ["cpu", "memory"]
            }
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "object" },
              { "type": "null" }
            ]
          }
        },
        "tolerations": {
          "type": "array",
          "items": { "type": "object" }
        },
        "affinity": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "job": {
          "type": "object",
          "properties": {
            "image": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" },
            "spec": {
              "type": "object",
              "properties": {
                "ttlSecondsAfterFinished": { "type": "integer" }
              }
            },
            "initContainers": {
              "type": "object",
              "properties": {
                "image": { "type": "string" }
              },
              "required": ["image"]
            },
            "restartPolicy": { "type": "string" }
          }
        },
        "elastic_host": { "type": "string" },
        "elastic_port": { "type": "string" },
        "wait_for_host": { "type": "string" },
        "wait_for_port": { "type": "string" },
        "elastic_url": { "type": "string", "format": "uri" },
        "elastic_auth": { "type": "string" },
        "elasticsearch_host": { "type": "string", "format": "uri" },
        "elastic_password": { "type": "string" },
        "elastic_username": { "type": "string" },
        "elasticsearch_password": { "type": "string" },
        "elasticsearch_username": { "type": "string" },
        "waitforit_auth": { "type": "string" },
        "kibana_host": { "type": "string" },
        "kibana_host_and_port": { "type": "string" },
        "kibana_port": { "type": "string" },
        "waitfor_url": { "type": "string", "format": "uri" },
        "secrets": {
          "type": "object",
          "properties": {
            "internal_elastic_admin_client": { "type": "string" }
          },
          "required": ["internal_elastic_admin_client"]
        }
      },
      "required": ["endpoint", "image", "tag", "pullPolicy", "replicaCount", "service", "ingress", "resources"]
    },
    "curlImage": {
      "type": "object",
      "properties": {
        "repo": { "type": "string" },
        "tag": { "type": "string" }
      },
      "required": ["repo", "tag"]
    },
    "ConnectionUrls": {
      "type": "object",
      "properties": {
        "elastic": { "type": "string", "format": "uri" }
      },
      "required": ["elastic"]
    }
  },
  "required": ["kibana", "curlImage", "ConnectionUrls"]
}
