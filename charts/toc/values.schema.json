{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TOC Helm Chart Values Schema",
  "type": "object",
  "properties": {
    "endpoint": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9.-]+$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "aws",
        "onprem"
      ]
    },
    "dev_mode": {
      "type": "boolean"
    },
    "toc": {
      "type": "object",
      "properties": {
        "loadBalancerIP": {
          "type": "string"
        },
        "spc_support": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "address": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "address"
          ]
        },
        "emsui_subdomain": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "loadUsers": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._/-]+$"
        },
        "tag": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "nameOverride": {
          "type": "string"
        },
        "fullnameOverride": {
          "type": "string"
        },
        "usageLimits": {
          "type": "object",
          "properties": {
            "warningThreshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "criticalThreshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "percentageToFree": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "imageThresholdMB": {
              "type": "integer",
              "minimum": 0
            },
            "logThresholdMB": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "smtp": {
          "type": "object",
          "properties": {
            "senderEmail": {
              "type": "string",
              "format": "email"
            },
            "server": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "ssl": {
              "type": "boolean"
            },
            "startTls": {
              "type": "boolean"
            }
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer",
                "ExternalName"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[0-9]+m?$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(Mi|Gi|Ki)$"
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[0-9]+m?$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(Mi|Gi|Ki)$"
                }
              }
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "targetMemoryUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "pathType": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "path",
                        "pathType"
                      ]
                    }
                  }
                },
                "required": [
                  "host",
                  "paths"
                ]
              }
            }
          }
        },
        "ConnectionUrls": {
          "type": "object",
          "properties": {
            "elastic": {
              "type": "string",
              "format": "uri"
            },
            "keycloak": {
              "type": "object",
              "properties": {
                "aws": {
                  "type": "string",
                  "format": "uri"
                },
                "onprem": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "aws",
                "onprem"
              ]
            },
            "spark": {
              "type": "string",
              "format": "uri"
            },
            "mongo": {
              "type": "object",
              "properties": {
                "aws": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "uri"
                  ]
                },
                "onprem": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "uri"
                  ]
                }
              },
              "required": [
                "aws",
                "onprem"
              ]
            },
            "pgDb": {
              "type": "object",
              "properties": {
                "dbname": {
                  "type": "string"
                },
                "host": {
                  "type": "string"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        },
        "dbs": {
          "type": "object",
          "properties": {
            "mongo": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              }
            }
          }
        },
        "aws_config": {
          "type": "object",
          "properties": {
            "resource_prefix": {
              "type": "string"
            },
            "resource_suffix": {
              "type": "string"
            },
            "sftp_server_type": {
              "type": "string",
              "enum": [
                "none",
                "ec2",
                "fargate"
              ]
            },
            "accountId": {
              "type": "string",
              "pattern": "^[0-9]{12}$"
            },
            "kmsKey": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "awsCredentials": {
              "type": "object",
              "properties": {
                "region": {
                  "type": "string"
                }
              }
            },
            "hostedZoneId": {
              "type": "string"
            },
            "sftp_subdomain": {
              "type": "string"
            },
            "recordValue": {
              "type": "string"
            }
          }
        },
        "topicOperator": {
          "type": "object",
          "properties": {
            "kafkaBootstrapServers": {
              "type": "string"
            }
          }
        },
        "serviceAccountName": {
          "type": "string"
        },
        "initContainers": {
          "type": "object",
          "properties": {
            "curlImage": {
              "type": "object",
              "properties": {
                "repo": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                }
              }
            },
            "mongoImage": {
              "type": "object",
              "properties": {
                "repo": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                }
              }
            }
          }
        },
        "import_regions": {
          "type": "object",
          "properties": {
            "image": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "secrets": {
          "type": "object",
          "properties": {
            "external_ems_aoa_client": {
              "type": "string"
            },
            "internal_pg_client": {
              "type": "string"
            },
            "internal_elastic_client": {
              "type": "string"
            },
            "internal_keycloak_toc_client": {
              "type": "string"
            }
          }
        },
        "smallcell_support": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "ems-platform_toc_access_role": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "endpoint",
    "platform",
    "dev_mode",
    "toc"
  ]
}