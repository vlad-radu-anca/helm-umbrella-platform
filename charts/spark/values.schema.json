{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "description": "Global values passed from the umbrella chart",
      "additionalProperties": true
    },
    "platform": {
      "type": "string",
      "enum": ["onprem", "aws"]
    },
    "endpoint": {
      "type": "string"
    },
    "spark": {
      "type": "object",
      "properties": {
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string" },
        "spark_jvm_options": { "type": "string" },
        "sse_enb_snmp_proxy_enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer" },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" }
            },
            "required": ["name"]
          }
        },
        "nameOverride": { "type": "string" },
        "fullnameOverride": { "type": "string" },
        "podAnnotations": {
          "type": ["object", "null"],
          "additionalProperties": { "type": "string" }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer" }
          },
          "required": ["type", "port"]
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": {
              "type": ["object", "null"],
              "additionalProperties": { "type": "string" }
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "host": { "type": "string" },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": { "type": "string" },
                        "pathType": { "type": "string" }
                      },
                      "required": ["path", "pathType"]
                    }
                  }
                },
                "required": ["host", "paths"]
              }
            },
            "tls": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "secretName": { "type": "string" },
                  "hosts": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "required": ["secretName", "hosts"]
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" }
              }
            }
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "object" },
              { "type": "null" }
            ]
          }
        },
        "tolerations": {
          "type": "array",
          "items": { "type": "object" }
        },
        "affinity": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "enb_support": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          },
          "required": ["enabled"]
        },
        "cpe_support": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          },
          "required": ["enabled"]
        },
        "gNB_support": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          },
          "required": ["enabled"]
        },
        "snmpproxy_jvm_options": { "type": "string" },
        "snmpproxy_memory": { "type": "string" },
        "snmpproxy_agent_port": { "type": "integer" },
        "snmpproxy_notification_port": { "type": "integer" },
        "snmpproxy_trap_port": { "type": "integer" },
        "initContainers": {
          "type": "object",
          "properties": {
            "curlImage": {
              "type": "object",
              "properties": {
                "repo": { "type": "string" },
                "tag": { "type": "string" }
              },
              "required": ["repo", "tag"]
            }
          }
        },
        "secrets": {
          "type": "object",
          "properties": {
            "internal_elastic_client": { "type": "string" },
            "identity": { "type": "string" },
            "trust": { "type": "string" }
          },
          "required": ["internal_elastic_client", "identity", "trust"]
        }
      },
      "required": ["image", "tag", "pullPolicy", "replicaCount", "service"]
    }
  },
  "required": ["platform", "endpoint", "spark"]
}
